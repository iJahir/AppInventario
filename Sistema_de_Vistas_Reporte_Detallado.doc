    }
    h2 {
        color: #007BFF;
        font-size: 20pt;
        margin-top: 30px;
        border-bottom: 1px solid #E0E0E0;
        padding-bottom: 5px;
    }
    h3 {
        color: #333333;
        font-size: 14pt;
        margin-top: 20px;
        background-color: #F3F0FC;
        padding: 8px 15px;
        border-left: 5px solid #5E17EB;
        border-radius: 0 4px 4px 0;
    }
    p, li {
        font-size: 11.5pt;
    }
    ul {
        margin-bottom: 15px;
    }
    li {
        margin-bottom: 5px;
    }
    .badge {
        background-color: #E8E5F9;
